# =========================================================
# FINTRACK - ENVIRONMENT VARIABLES
# =========================================================

# =========================================================
# DATABASE - SUPABASE POSTGRESQL
# Supabase URL + publishable key are safe for browser use when RLS is enabled.
# =========================================================
VITE_SUPABASE_URL=https://kqpumgzmhfhoucfdvlqk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# =========================================================
# LEGACY DATABASE - MONGODB ATLAS (NOT USED BY THE NEW DATA LAYER)
# =========================================================
# Never expose these values with a VITE_ prefix.
# =========================================================
MONGODB_URI=
MONGODB_DB=fintrack

# =========================================================
# AI - OPENROUTER (SERVER ONLY)
# Never expose OPENROUTER_API_KEY to the frontend.
# =========================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APP_NAME=FinTrack
OPENROUTER_SITE_URL=http://localhost:3000

# =========================================================
# APPLICATION
# Keep these URLs aligned with the local Vite port (3000).
# =========================================================
APP_URL=http://localhost:3000
NODE_ENV=development

# =========================================================
# FIREBASE AUTHENTICATION
# Frontend configuration only; do not put Admin SDK credentials here.
# =========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=